MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database
JWT_SECRET=your-jwt-secret-key
NODE_ENV=production
PORT=8000
PING_URL=https://your-render-url.onrender.com/

# ImageKit (관리자 미디어 페이지)
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/gc3jtyt9o

# -- AI 초안(Claude) --------------------------------------------
# console.anthropic.com 에서 발급한 API 키. 미설정 시 AI 초안·AI 글쓰기는 503 안내로 비활성.
ANTHROPIC_API_KEY=
# identity 연동 키를 쓸 때만 필요(워크스페이스 전용 키면 생략). Console 워크스페이스 설정에서 확인.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
# 선택: 모델·사고 깊이 오버라이드(기본 claude-opus-5 / low)
# ANTHROPIC_CHAT_MODEL=claude-opus-5
# ANTHROPIC_CHAT_EFFORT=low
